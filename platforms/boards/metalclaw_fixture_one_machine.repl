    TxDMA -> d_dma@28
    RxDMA -> d_dma@29

d_uart1: UART.RP2_UART @ { sysbus new Bus.BusPointRegistration { address: 0x40078000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40078000; cpu: d_dma_bus }; d_resets 27 }
    clocks: d_clocks
    gpio: d_gpio
