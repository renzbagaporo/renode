// Generated by scripts/multi-node/gen_rp2_chip_repl.py: the Metalclaw fixture's
// harness Pico (h_) and its Pico 2 DUT (d_) as two chips in one machine.
//   gen_rp2_chip_repl.py h platforms/boards/raspberry_pi_pico.repl
//   gen_rp2_chip_repl.py d platforms/boards/raspberry_pi_pico2.repl

h_chip: Miscellaneous.RP2_Chip @ sysbus
    prefix: "h_"
h_cluster: CPU.Cluster @ sysbus
h_dma_bus: Miscellaneous.RP2_BusMaster @ sysbus



h_cpu0: CPU.CortexM @ h_cluster
    cpuType: "cortex-m0+"
    nvic: h_nvic0
    cpuId: 0
    PerformanceInMips: 125
    InitVectorTableOffset: 0
    
    
    WfiFollowsClock: true
h_cpu1: CPU.CortexM @ h_cluster
    cpuType: "cortex-m0+"
    nvic: h_nvic1
    cpuId: 1
    PerformanceInMips: 125
    InitVectorTableOffset: 0
    WfiFollowsClock: true
h_nvic0: IRQControllers.NVIC @ sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: h_cpu0 }
    -> h_cpu0@0
    priorityMask: 0xc0
h_nvic1: IRQControllers.NVIC @ sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: h_cpu1 }
    -> h_cpu1@0
    priorityMask: 0xc0
h_debug_port: CPU.RP2040_DebugPort @ sysbus
    cpu0: h_cpu0
    cpu1: h_cpu1


h_bpu0: CPU.ARM_FlashPatchBreakpoint @ sysbus new Bus.BusPointRegistration { address: 0xe0002000; cpu: h_cpu0 }
    cpu: h_cpu0

h_bpu1: CPU.ARM_FlashPatchBreakpoint @ sysbus new Bus.BusPointRegistration { address: 0xe0002000; cpu: h_cpu1 }
    cpu: h_cpu1

h_romTable: CPU.CortexM_ROMTable @ { sysbus new Bus.BusPointRegistration { address: 0xe00ff000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0xe00ff000; cpu: h_dma_bus } }
    fpb: h_bpu0

h_rom: Memory.MappedMemory @ { sysbus new Bus.BusPointRegistration { address: 0; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0; cpu: h_dma_bus } }
    size: 0x4000
h_sram: Memory.MappedMemory @ { sysbus new Bus.BusPointRegistration { address: 0x20000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x20000000; cpu: h_dma_bus } }
    size: 0x42000
h_sio: Miscellaneous.RP2040_SIO @ { sysbus new Bus.BusPointRegistration { address: 0xd0000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0xd0000000; cpu: h_dma_bus }; h_psm 14 }
    Core0IRQ -> h_nvic0@15 | h_nvic1@15
    Core1IRQ -> h_nvic0@16 | h_nvic1@16
h_psm: Miscellaneous.RP2040_PSM @ { sysbus new Bus.BusPointRegistration { address: 0x40010000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40010000; cpu: h_dma_bus } }
    core0: h_cpu0
    core1: h_cpu1
    nvic0: h_nvic0
    nvic1: h_nvic1

h_nvic0:
    SystemResetRequest -> h_psm@1

h_nvic1:
    SystemResetRequest -> h_psm@2
h_resets: Miscellaneous.RP2_Resets @ { sysbus new Bus.BusPointRegistration { address: 0x4000c000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4000c000; cpu: h_dma_bus }; h_psm 3 }
h_rosc: Miscellaneous.RP2040_ROSC @ { sysbus new Bus.BusPointRegistration { address: 0x40060000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40060000; cpu: h_dma_bus }; h_psm 0 }
h_vreg_and_chip_reset: Miscellaneous.RP2040_VregAndChipReset @ { sysbus new Bus.BusPointRegistration { address: 0x40064000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40064000; cpu: h_dma_bus } }
h_xosc: Miscellaneous.RP2_XOSC @ { sysbus new Bus.BusPointRegistration { address: 0x40024000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40024000; cpu: h_dma_bus }; h_psm 1 }
h_pll_sys: Miscellaneous.RP2_PLL @ { sysbus new Bus.BusPointRegistration { address: 0x40028000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40028000; cpu: h_dma_bus }; h_resets 12 }
    xosc: h_xosc
h_pll_usb: Miscellaneous.RP2_PLL @ { sysbus new Bus.BusPointRegistration { address: 0x4002c000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4002c000; cpu: h_dma_bus }; h_resets 13 }
    xosc: h_xosc
h_clocks: Miscellaneous.RP2040_Clocks @ { sysbus new Bus.BusPointRegistration { address: 0x40008000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40008000; cpu: h_dma_bus }; h_psm 2 }
    rosc: h_rosc
    xosc: h_xosc
    pllSys: h_pll_sys
    pllUsb: h_pll_usb
    nvic0: h_nvic0
    nvic1: h_nvic1
    sio: h_sio
    gpio: h_gpio
    IRQ -> h_nvic0@17 | h_nvic1@17
h_timer: Timers.RP2_Timer @ { sysbus new Bus.BusPointRegistration { address: 0x40054000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40054000; cpu: h_dma_bus }; h_resets 21 }
    clocked: true
    0 -> h_nvic0@0 | h_nvic1@0
    1 -> h_nvic0@1 | h_nvic1@1
    2 -> h_nvic0@2 | h_nvic1@2
    3 -> h_nvic0@3 | h_nvic1@3
h_watchdog: Miscellaneous.RP2040_Watchdog @ { sysbus new Bus.BusPointRegistration { address: 0x40058000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40058000; cpu: h_dma_bus } }
    clocks: h_clocks
    timer: h_timer
    psm: h_psm
h_gpio: GPIOPort.RP2_GPIOBank0 @ { sysbus new Bus.BusPointRegistration { address: 0x40014000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40014000; cpu: h_dma_bus }; h_resets 5 }
    sio: h_sio
    Core0IRQ -> h_nvic0@13
    Core1IRQ -> h_nvic1@13
    DormantWakeIRQ -> h_xosc@0 | h_rosc@0
h_pads: GPIOPort.RP2_PadsBank0 @ { sysbus new Bus.BusPointRegistration { address: 0x4001c000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4001c000; cpu: h_dma_bus }; h_resets 8 }
    gpio: h_gpio

h_dma: DMA.RP2040_DMA @ { sysbus new Bus.BusPointRegistration { address: 0x50000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50000000; cpu: h_dma_bus }; h_resets 2 }
    busContext: h_dma_bus
    clocks: h_clocks
    IRQ0 -> h_nvic0@11 | h_nvic1@11
    IRQ1 -> h_nvic0@12 | h_nvic1@12

h_pio0: Miscellaneous.RP2040_PIO @ { sysbus new Bus.BusPointRegistration { address: 0x50200000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50200000; cpu: h_dma_bus }; h_resets 10 }
    gpio: h_gpio
    clocks: h_clocks
    pioId: 0
    0 -> h_dma@0
    1 -> h_dma@1
    2 -> h_dma@2
    3 -> h_dma@3
    4 -> h_dma@4
    5 -> h_dma@5
    6 -> h_dma@6
    7 -> h_dma@7
    8 -> h_nvic0@7 | h_nvic1@7
    9 -> h_nvic0@8 | h_nvic1@8

h_pio1: Miscellaneous.RP2040_PIO @ { sysbus new Bus.BusPointRegistration { address: 0x50300000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50300000; cpu: h_dma_bus }; h_resets 11 }
    gpio: h_gpio
    clocks: h_clocks
    pioId: 1
    0 -> h_dma@8
    1 -> h_dma@9
    2 -> h_dma@10
    3 -> h_dma@11
    4 -> h_dma@12
    5 -> h_dma@13
    6 -> h_dma@14
    7 -> h_dma@15
    8 -> h_nvic0@9 | h_nvic1@9
    9 -> h_nvic0@10 | h_nvic1@10

h_dpram: USB.RP2_USB_DPRAM @ { sysbus new Bus.BusPointRegistration { address: 0x50100000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50100000; cpu: h_dma_bus } }
h_usb: USB.RP2_USB @ { sysbus new Bus.BusPointRegistration { address: 0x50110000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50110000; cpu: h_dma_bus }; h_resets 24 }
    dpram: h_dpram
    clockSource: h_clocks
    IRQ -> h_nvic0@5 | h_nvic1@5

h_ssi: SPI.RP2040_SSI @ { sysbus new Bus.BusPointRegistration { address: 0x18000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x18000000; cpu: h_dma_bus }; h_psm 12 }
    IRQ -> h_nvic0@6 | h_nvic1@6
    TxDMA -> h_dma@38
    RxDMA -> h_dma@39

h_qspi: GPIOPort.RP2040_QSPI @ { sysbus new Bus.BusPointRegistration { address: 0x40018000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40018000; cpu: h_dma_bus }; h_resets 6 }
    sio: h_sio
    ssi: h_ssi
    Core0IRQ -> h_nvic0@14
    Core1IRQ -> h_nvic1@14

h_qpads: GPIOPort.RP2040_PadsQSPI @ { sysbus new Bus.BusPointRegistration { address: 0x40020000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40020000; cpu: h_dma_bus }; h_resets 9 }
    gpio: h_qspi

h_sysinfo: Miscellaneous.RP2040_SYSINFO @ { sysbus new Bus.BusPointRegistration { address: 0x40000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: h_dma_bus } }

h_busctrl: Miscellaneous.RP2040_BUSCTRL @ { sysbus new Bus.BusPointRegistration { address: 0x40030000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40030000; cpu: h_dma_bus }; h_resets 1 }
    core0: h_cpu0
    core1: h_cpu1
    dma: h_dma


h_rtc: Timers.RP2040_RTC @ { sysbus new Bus.BusPointRegistration { address: 0x4005c000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4005c000; cpu: h_dma_bus }; h_resets 15 }
    clocks: h_clocks
    IRQ -> h_nvic0@25 | h_nvic1@25 | h_xosc@0 | h_rosc@0

h_pwm: Timers.RP2_PWM @ { sysbus new Bus.BusPointRegistration { address: 0x40050000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40050000; cpu: h_dma_bus }; h_resets 14 }
    clocks: h_clocks
    gpio: h_gpio
    IRQ -> h_nvic0@4 | h_nvic1@4
    0 -> h_dma@88
    1 -> h_dma@89
    2 -> h_dma@90
    3 -> h_dma@91
    4 -> h_dma@92
    5 -> h_dma@93
    6 -> h_dma@94
    7 -> h_dma@95

h_uart0: UART.RP2_UART @ { sysbus new Bus.BusPointRegistration { address: 0x40034000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40034000; cpu: h_dma_bus }; h_resets 22 }
    clocks: h_clocks
    gpio: h_gpio
    index: 0
    IRQ -> h_nvic0@20 | h_nvic1@20
    TxDMA -> h_dma@20
    RxDMA -> h_dma@21

h_uart1: UART.RP2_UART @ { sysbus new Bus.BusPointRegistration { address: 0x40038000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40038000; cpu: h_dma_bus }; h_resets 23 }
    clocks: h_clocks
    gpio: h_gpio
    index: 1
    IRQ -> h_nvic0@21 | h_nvic1@21
    TxDMA -> h_dma@22
    RxDMA -> h_dma@23

h_spi0: SPI.RP2_SPI @ { sysbus new Bus.BusPointRegistration { address: 0x4003c000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4003c000; cpu: h_dma_bus }; h_resets 16 }
    clocks: h_clocks
    gpio: h_gpio
    index: 0
    IRQ -> h_nvic0@18 | h_nvic1@18
    TxDMA -> h_dma@16
    RxDMA -> h_dma@17

h_spi1: SPI.RP2_SPI @ { sysbus new Bus.BusPointRegistration { address: 0x40040000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40040000; cpu: h_dma_bus }; h_resets 17 }
    clocks: h_clocks
    gpio: h_gpio
    index: 1
    IRQ -> h_nvic0@19 | h_nvic1@19
    TxDMA -> h_dma@18
    RxDMA -> h_dma@19

h_i2c0: I2C.RP2_I2C @ { sysbus new Bus.BusPointRegistration { address: 0x40044000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40044000; cpu: h_dma_bus }; h_resets 3 }
    clocks: h_clocks
    gpio: h_gpio
    index: 0
    IRQ -> h_nvic0@23 | h_nvic1@23
    TxDMA -> h_dma@32
    RxDMA -> h_dma@33

h_i2c1: I2C.RP2_I2C @ { sysbus new Bus.BusPointRegistration { address: 0x40048000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40048000; cpu: h_dma_bus }; h_resets 4 }
    clocks: h_clocks
    gpio: h_gpio
    index: 1
    IRQ -> h_nvic0@24 | h_nvic1@24
    TxDMA -> h_dma@34
    RxDMA -> h_dma@35

h_adc: Analog.RP2_ADC @ { sysbus new Bus.BusPointRegistration { address: 0x4004c000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4004c000; cpu: h_dma_bus }; h_resets 0 }
    gpio: h_gpio
    IRQ -> h_nvic0@22 | h_nvic1@22
    DREQ -> h_dma@36

h_flashMemory: Memory.MappedMemory
    size: 0x200000

h_flash: SPI.WinbondW25QFlash @ h_ssi 0
    underlyingMemory: h_flashMemory

h_xip: MemoryControllers.RP2040_XIP @ { sysbus new Bus.BusPointRegistration { address: 0x14000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x14000000; cpu: h_dma_bus }; h_psm 12 }
    ssi: h_ssi
    flash: h_flash
    StreamDMA -> h_dma@37

h_xipAux: MemoryControllers.RP2_XIPAux @ { sysbus new Bus.BusPointRegistration { address: 0x50400000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50400000; cpu: h_dma_bus } }
    xip: h_xip




h_xipMemory: Memory.RP2040_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x10000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x10000000; cpu: h_dma_bus } }
    flash: h_flash
    xip: h_xip

h_xipNoAlloc: Memory.RP2040_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x11000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x11000000; cpu: h_dma_bus } }
    flash: h_flash
    xip: h_xip
    allocate: false

h_xipNoCache: Memory.RP2040_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x12000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x12000000; cpu: h_dma_bus } }
    flash: h_flash
    xip: h_xip
    cached: false

h_xipNoCacheNoAlloc: Memory.RP2040_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x13000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x13000000; cpu: h_dma_bus } }
    flash: h_flash
    xip: h_xip
    cached: false
    allocate: false
d_chip: Miscellaneous.RP2_Chip @ sysbus
    prefix: "d_"
d_cluster: CPU.Cluster @ sysbus
d_dma_bus: Miscellaneous.RP2_BusMaster @ sysbus




d_cpu0: CPU.CortexM @ d_cluster
    cpuType: "cortex-m33-rp2350"
    nvic: d_nvic0
    enableTrustZone: true
    GPIOCoprocessor: d_sio
    InitVectorTableOffset: 0
    
    
    WfiFollowsClock: true

d_cpu1: CPU.CortexM @ d_cluster
    cpuType: "cortex-m33-rp2350"
    nvic: d_nvic1
    cpuId: 1
    enableTrustZone: true
    GPIOCoprocessor: d_sio
    InitVectorTableOffset: 0
    WfiFollowsClock: true
    isCpuWaitSignalSet: true

// The RISC-V cores join d_cluster before anything registers for the
// cluster, so each registration reaches them as well as the Arm cores.
d_riscv0: CPU.RP2350_Hazard3 @ d_cluster
    hartId: 0
    WfiFollowsClock: true

d_riscv1: CPU.RP2350_Hazard3 @ d_cluster
    hartId: 1
    WfiFollowsClock: true

d_nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: d_cpu0 };
    sysbus new Bus.BusMultiRegistration { address: 0xe002e000; size: 0x1000; region: "NonSecure"; cpu: d_cpu0 }
}
    -> d_cpu0@0
    systickFrequency: 6000000
    priorityMask: 0xf0

d_nvic1: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: d_cpu1 };
    sysbus new Bus.BusMultiRegistration { address: 0xe002e000; size: 0x1000; region: "NonSecure"; cpu: d_cpu1 }
}
    -> d_cpu1@0
    systickFrequency: 6000000
    priorityMask: 0xf0

d_rom: Memory.RP2350_ROM @ { sysbus new Bus.BusPointRegistration { address: 0; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0; cpu: d_dma_bus }; d_psm 8 }

d_bootram: Memory.RP2350_BootRAM @ { sysbus new Bus.BusPointRegistration { address: 0x400e0000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400e0000; cpu: d_dma_bus }; d_psm 9 }
    accessControl: d_accessctrl

d_sram: Memory.MappedMemory @ { sysbus new Bus.BusPointRegistration { address: 0x20000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x20000000; cpu: d_dma_bus } }
    size: 0x40000

d_sramHigh: Memory.MappedMemory @ { sysbus new Bus.BusPointRegistration { address: 0x20040000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x20040000; cpu: d_dma_bus } }
    size: 0x42000

d_resets: Miscellaneous.RP2_Resets @ { sysbus new Bus.BusPointRegistration { address: 0x40020000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40020000; cpu: d_dma_bus }; d_psm 4 }
    rp2350: true

d_xosc: Miscellaneous.RP2_XOSC @ { sysbus new Bus.BusPointRegistration { address: 0x40048000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40048000; cpu: d_dma_bus }; d_psm 3 }
    crystalFrequency: 12000000
    rp2350: true

d_rosc: Miscellaneous.RP2350_ROSC @ { sysbus new Bus.BusPointRegistration { address: 0x400e8000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400e8000; cpu: d_dma_bus }; d_psm 2 }

d_pll_sys: Miscellaneous.RP2_PLL @ {
    sysbus new Bus.BusPointRegistration { address: 0x40050000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40050000; cpu: d_dma_bus };
    d_resets 14
}
    xosc: d_xosc
    rp2350: true

d_pll_usb: Miscellaneous.RP2_PLL @ {
    sysbus new Bus.BusPointRegistration { address: 0x40058000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40058000; cpu: d_dma_bus };
    d_resets 15
}
    xosc: d_xosc
    rp2350: true

d_clocks: Miscellaneous.RP2350_Clocks @ { sysbus new Bus.BusPointRegistration { address: 0x40010000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40010000; cpu: d_dma_bus }; d_psm 5 }
    xosc: d_xosc
    rosc: d_rosc
    pllSys: d_pll_sys
    pllUsb: d_pll_usb
    nvic0: d_nvic0
    nvic1: d_nvic1
    IRQ -> d_nvic0@30 | d_riscv0@30 | d_nvic1@30 | d_riscv1@30


d_ticks: Miscellaneous.RP2350_Ticks @ { sysbus new Bus.BusPointRegistration { address: 0x40108000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40108000; cpu: d_dma_bus }; d_psm 5 }
    clocks: d_clocks
    timer0: d_timer0
    timer1: d_timer1

d_sha256: Miscellaneous.RP2350_SHA256 @ { sysbus new Bus.BusPointRegistration { address: 0x400f8000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400f8000; cpu: d_dma_bus }; d_resets 17 }
    clocks: d_clocks
    DREQ -> d_dma@54



d_hstx: Miscellaneous.RP2350_HSTX @ { sysbus new Bus.BusPointRegistration { address: 0x400c0000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400c0000; cpu: d_dma_bus }; d_resets 3 }
    clocks: d_clocks
    DREQ -> d_dma@52

d_hstx_fifo: Miscellaneous.RP2350_HSTXFifo @ { sysbus new Bus.BusPointRegistration { address: 0x50600000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50600000; cpu: d_dma_bus } }
    hstx: d_hstx

d_trng: Miscellaneous.RP2350_TRNG @ { sysbus new Bus.BusPointRegistration { address: 0x400f0000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400f0000; cpu: d_dma_bus }; d_resets 25 }
    clocks: d_clocks
    IRQ -> d_nvic0@39 | d_riscv0@39 | d_nvic1@39 | d_riscv1@39

d_debug_port: CPU.RP2350_DebugPort @ sysbus
    architectureSelector: d_architecture
    cpu0: d_cpu0
    cpu1: d_cpu1

d_powman: Miscellaneous.RP2350_POWMAN @ { sysbus new Bus.BusPointRegistration { address: 0x40100000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40100000; cpu: d_dma_bus } }
    architectureSelector: d_architecture
    xosc: d_xosc
    rosc: d_rosc
    gpio: d_gpio
    TimerIRQ -> d_nvic0@45 | d_riscv0@45 | d_nvic1@45 | d_riscv1@45
    core0: d_cpu0
    core1: d_cpu1
    nvic0: d_nvic0
    nvic1: d_nvic1
    debugPort: d_debug_port
    bootRAM: d_bootram
    xip: d_xip
    sramLow: d_sram
    sramHigh: d_sramHigh

d_nvic0:
    SystemResetRequest -> d_powman@0

d_nvic1:
    SystemResetRequest -> d_powman@1

d_otp: Miscellaneous.RP2350_OTP @ { sysbus new Bus.BusPointRegistration { address: 0x40120000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40120000; cpu: d_dma_bus }; d_psm 1 }

d_otpData: Memory.RP2350_OTPData @ { sysbus new Bus.BusPointRegistration { address: 0x40130000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40130000; cpu: d_dma_bus } }
    otp: d_otp

d_otpRaw: Memory.RP2350_OTPData @ { sysbus new Bus.BusPointRegistration { address: 0x40134000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40134000; cpu: d_dma_bus } }
    otp: d_otp
    raw: true

d_otpGuarded: Memory.RP2350_OTPData @ { sysbus new Bus.BusPointRegistration { address: 0x40138000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40138000; cpu: d_dma_bus } }
    otp: d_otp
    guarded: true

d_otpRawGuarded: Memory.RP2350_OTPData @ { sysbus new Bus.BusPointRegistration { address: 0x4013c000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x4013c000; cpu: d_dma_bus } }
    otp: d_otp
    raw: true
    guarded: true

d_sysinfo: Miscellaneous.RP2350_SYSINFO @ { sysbus new Bus.BusPointRegistration { address: 0x40000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: d_dma_bus }; d_resets 21 }

d_accessctrl: Miscellaneous.RP2350_AccessControl @ { sysbus new Bus.BusPointRegistration { address: 0x40060000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40060000; cpu: d_dma_bus }; d_psm 22 }

d_psm: Miscellaneous.RP2350_PSM @ { sysbus new Bus.BusPointRegistration { address: 0x40018000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40018000; cpu: d_dma_bus } }
    core0: d_cpu0
    core1: d_cpu1
    nvic0: d_nvic0
    nvic1: d_nvic1

d_dpram: USB.RP2_USB_DPRAM @ { sysbus new Bus.BusPointRegistration { address: 0x50100000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50100000; cpu: d_dma_bus } }

d_sio: Miscellaneous.RP2350_SIO @ {
    d_psm 21;
    sysbus new Bus.BusPointRegistration { address: 0xd0000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0xd0000000; cpu: d_dma_bus };
    sysbus new Bus.BusMultiRegistration { address: 0xd0020000; size: 0x1000; region: "NonSecure"; cluster: d_cluster }; sysbus new Bus.BusMultiRegistration { address: 0xd0020000; size: 0x1000; region: "NonSecure"; cpu: d_dma_bus }
}
    accessControl: d_accessctrl
    Core0IRQ -> d_nvic0@25 | d_riscv0@25
    Core1IRQ -> d_nvic1@25 | d_riscv1@25
    Core0NonSecureIRQ -> d_nvic0@27 | d_riscv0@27
    Core1NonSecureIRQ -> d_nvic1@27 | d_riscv1@27
    Core0DoorbellIRQ -> d_nvic0@26 | d_riscv0@26
    Core1DoorbellIRQ -> d_nvic1@26 | d_riscv1@26
    Core0NonSecureDoorbellIRQ -> d_nvic0@28 | d_riscv0@28
    Core1NonSecureDoorbellIRQ -> d_nvic1@28 | d_riscv1@28

d_timer0: Timers.RP2_Timer @ { sysbus new Bus.BusPointRegistration { address: 0x400b0000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400b0000; cpu: d_dma_bus }; d_resets 23 }
    clocked: true
    rp2350: true
    0 -> d_nvic0@0 | d_riscv0@0 | d_nvic1@0 | d_riscv1@0
    1 -> d_nvic0@1 | d_riscv0@1 | d_nvic1@1 | d_riscv1@1
    2 -> d_nvic0@2 | d_riscv0@2 | d_nvic1@2 | d_riscv1@2
    3 -> d_nvic0@3 | d_riscv0@3 | d_nvic1@3 | d_riscv1@3

d_timer1: Timers.RP2_Timer @ { sysbus new Bus.BusPointRegistration { address: 0x400b8000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400b8000; cpu: d_dma_bus }; d_resets 24 }
    clocked: true
    rp2350: true
    0 -> d_nvic0@4 | d_riscv0@4 | d_nvic1@4 | d_riscv1@4
    1 -> d_nvic0@5 | d_riscv0@5 | d_nvic1@5 | d_riscv1@5
    2 -> d_nvic0@6 | d_riscv0@6 | d_nvic1@6 | d_riscv1@6
    3 -> d_nvic0@7 | d_riscv0@7 | d_nvic1@7 | d_riscv1@7

d_watchdog: Miscellaneous.RP2350_Watchdog @ { sysbus new Bus.BusPointRegistration { address: 0x400d8000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400d8000; cpu: d_dma_bus } }
    ticks: d_ticks
    psm: d_psm
    powman: d_powman

d_gpio: GPIOPort.RP2_GPIOBank0 @ { sysbus new Bus.BusPointRegistration { address: 0x40028000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40028000; cpu: d_dma_bus }; d_resets 6 }
    sio: d_sio
    rp2350: true
    accessControl: d_accessctrl
    Core0IRQ -> d_nvic0@21 | d_riscv0@21
    Core1IRQ -> d_nvic1@21 | d_riscv1@21
    DormantWakeIRQ -> d_xosc@0 | d_rosc@0
    Core0NonSecureIRQ -> d_nvic0@22 | d_riscv0@22
    Core1NonSecureIRQ -> d_nvic1@22 | d_riscv1@22

d_pads: GPIOPort.RP2_PadsBank0 @ { sysbus new Bus.BusPointRegistration { address: 0x40038000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40038000; cpu: d_dma_bus }; d_resets 9 }
    gpio: d_gpio
    rp2350: true

d_fpb0: CPU.ARM_FlashPatchBreakpoint @ sysbus new Bus.BusPointRegistration { address: 0xe0002000; cpu: d_cpu0 }
    cpu: d_cpu0

d_fpb1: CPU.ARM_FlashPatchBreakpoint @ sysbus new Bus.BusPointRegistration { address: 0xe0002000; cpu: d_cpu1 }
    cpu: d_cpu1

d_romTable: CPU.CortexM_ROMTable @ { sysbus new Bus.BusPointRegistration { address: 0xe00ff000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0xe00ff000; cpu: d_dma_bus } }
    fpb: d_fpb0

d_usb: USB.RP2_USB @ { sysbus new Bus.BusPointRegistration { address: 0x50110000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50110000; cpu: d_dma_bus }; d_resets 28 }
    dpram: d_dpram
    clockSource: d_clocks
    IRQ -> d_nvic0@14 | d_riscv0@14 | d_nvic1@14 | d_riscv1@14

d_xip: MemoryControllers.RP2350_XIP @ { sysbus new Bus.BusPointRegistration { address: 0x400c8000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400c8000; cpu: d_dma_bus }; d_psm 20 }
    StreamDMA -> d_dma@49

d_xipAux: MemoryControllers.RP2_XIPAux @ { sysbus new Bus.BusPointRegistration { address: 0x50500000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50500000; cpu: d_dma_bus } }
    xip: d_xip

d_xipMaintenance: MemoryControllers.RP2350_XIPMaintenance @ { sysbus new Bus.BusPointRegistration { address: 0x18000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x18000000; cpu: d_dma_bus } }
    xip: d_xip

d_dma: DMA.RP2040_DMA @ { sysbus new Bus.BusPointRegistration { address: 0x50000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50000000; cpu: d_dma_bus }; d_resets 2 }
    busContext: d_dma_bus
    clocks: d_clocks
    rp2350: true
    IRQ0 -> d_nvic0@10 | d_riscv0@10 | d_nvic1@10 | d_riscv1@10
    IRQ1 -> d_nvic0@11 | d_riscv0@11 | d_nvic1@11 | d_riscv1@11
    IRQ2 -> d_nvic0@12 | d_riscv0@12 | d_nvic1@12 | d_riscv1@12
    IRQ3 -> d_nvic0@13 | d_riscv0@13 | d_nvic1@13 | d_riscv1@13

d_pio0: Miscellaneous.RP2040_PIO @ { sysbus new Bus.BusPointRegistration { address: 0x50200000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50200000; cpu: d_dma_bus }; d_resets 11 }
    gpio: d_gpio
    clocks: d_clocks
    pioId: 0
    rp2350: true
    0 -> d_dma@0
    1 -> d_dma@1
    2 -> d_dma@2
    3 -> d_dma@3
    4 -> d_dma@4
    5 -> d_dma@5
    6 -> d_dma@6
    7 -> d_dma@7
    8 -> d_nvic0@15 | d_riscv0@15 | d_nvic1@15 | d_riscv1@15
    9 -> d_nvic0@16 | d_riscv0@16 | d_nvic1@16 | d_riscv1@16

d_pio1: Miscellaneous.RP2040_PIO @ { sysbus new Bus.BusPointRegistration { address: 0x50300000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50300000; cpu: d_dma_bus }; d_resets 12 }
