    TxDMA -> d_dma@44
    RxDMA -> d_dma@45

d_i2c1: I2C.RP2_I2C @ { sysbus new Bus.BusPointRegistration { address: 0x40098000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40098000; cpu: d_dma_bus }; d_resets 5 }
