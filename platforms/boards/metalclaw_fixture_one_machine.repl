    rp2350: true
    IRQ -> d_nvic0@34 | d_riscv0@34 | d_nvic1@34 | d_riscv1@34
    TxDMA -> d_dma@30
    RxDMA -> d_dma@31

d_spi0: SPI.RP2_SPI @ { sysbus new Bus.BusPointRegistration { address: 0x40080000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40080000; cpu: d_dma_bus }; d_resets 18 }
    clocks: d_clocks
