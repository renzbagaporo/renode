    9 -> d_nvic0@18 | d_riscv0@18 | d_nvic1@18 | d_riscv1@18

d_pio2: Miscellaneous.RP2040_PIO @ { sysbus new Bus.BusPointRegistration { address: 0x50400000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50400000; cpu: d_dma_bus }; d_resets 13 }
    gpio: d_gpio
    clocks: d_clocks
    pioId: 2
    rp2350: true
    0 -> d_dma@16
    1 -> d_dma@17
    2 -> d_dma@18
    3 -> d_dma@19
    4 -> d_dma@20
    5 -> d_dma@21
    6 -> d_dma@22
    7 -> d_dma@23
    8 -> d_nvic0@19 | d_riscv0@19 | d_nvic1@19 | d_riscv1@19
    9 -> d_nvic0@20 | d_riscv0@20 | d_nvic1@20 | d_riscv1@20

d_pwm: Timers.RP2_PWM @ { sysbus new Bus.BusPointRegistration { address: 0x400a8000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400a8000; cpu: d_dma_bus }; d_resets 16 }
    clocks: d_clocks
    gpio: d_gpio
    rp2350: true
    IRQ -> d_nvic0@8 | d_riscv0@8 | d_nvic1@8 | d_riscv1@8
    IRQ1 -> d_nvic0@9 | d_riscv0@9 | d_nvic1@9 | d_riscv1@9
    0 -> d_dma@96
    1 -> d_dma@97
    2 -> d_dma@98
    3 -> d_dma@99
    4 -> d_dma@100
    5 -> d_dma@101
    6 -> d_dma@102
    7 -> d_dma@103
    8 -> d_dma@104
    9 -> d_dma@105
    10 -> d_dma@106
    11 -> d_dma@107

d_busctrl: Miscellaneous.RP2040_BUSCTRL @ { sysbus new Bus.BusPointRegistration { address: 0x40068000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40068000; cpu: d_dma_bus }; d_resets 1 }
    rp2350: true

d_uart0: UART.RP2_UART @ { sysbus new Bus.BusPointRegistration { address: 0x40070000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40070000; cpu: d_dma_bus }; d_resets 26 }
    clocks: d_clocks
    gpio: d_gpio
