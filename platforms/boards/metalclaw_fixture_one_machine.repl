    gpio: d_gpio
    rp2350: true
    IRQ -> d_nvic0@35 | d_riscv0@35 | d_nvic1@35 | d_riscv1@35
    DREQ -> d_dma@48



d_architecture: Miscellaneous.RP2350_ArchitectureSelector @ sysbus
    arm0: d_cpu0
    arm1: d_cpu1
    riscv0: d_riscv0
    riscv1: d_riscv1
    nvic0: d_nvic0
    nvic1: d_nvic1
    otp: d_otp
    psm: d_psm

d_flashMemory: Memory.MappedMemory
    size: 0x400000

d_flash: SPI.WinbondW25QFlash
    underlyingMemory: d_flashMemory

d_qmi: MemoryControllers.RP2350_QMI @ { sysbus new Bus.BusPointRegistration { address: 0x400d0000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400d0000; cpu: d_dma_bus }; d_psm 20 }
    flash: d_flash
    clocks: d_clocks

d_xipMemory: Memory.RP2350_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x10000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x10000000; cpu: d_dma_bus } }
    flash: d_flash
    qmi: d_qmi
    xip: d_xip

d_xipUncached: Memory.RP2350_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x14000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x14000000; cpu: d_dma_bus } }
    flash: d_flash
    qmi: d_qmi
    xip: d_xip
    useCache: false

d_xipUntranslated: Memory.RP2350_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x1c000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x1c000000; cpu: d_dma_bus } }
    flash: d_flash
    qmi: d_qmi
    untranslated: true
    useCache: false
    xip: d_xip

d_qspi: GPIOPort.RP2350_QSPI @ { sysbus new Bus.BusPointRegistration { address: 0x40030000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40030000; cpu: d_dma_bus }; d_resets 7 }
    qmi: d_qmi
    sio: d_sio
    accessControl: d_accessctrl
    Core0IRQ -> d_nvic0@23
    Core1IRQ -> d_nvic1@23
    Core0NonSecureIRQ -> d_nvic0@24
    Core1NonSecureIRQ -> d_nvic1@24

d_qpads: GPIOPort.RP2350_PadsQSPI @ { sysbus new Bus.BusPointRegistration { address: 0x40040000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40040000; cpu: d_dma_bus }; d_resets 10 }
    gpio: d_qspi

d_sysinfo:
    packageQfn60: true

d_gpio:
    numberOfPins: 30

d_pads:
    rp2350A2PadRemap: true

d_xipCacheMemory: Memory.RP2350_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x12000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x12000000; cpu: d_dma_bus } }
    flash: d_flash
    qmi: d_qmi
    xip: d_xip
    windowOffset: 0x2000000

d_xipUncachedReserved: Memory.RP2350_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x16000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x16000000; cpu: d_dma_bus } }
    flash: d_flash
    qmi: d_qmi
    xip: d_xip
    useCache: false
    windowOffset: 0x2000000

d_xipUntranslatedReserved: Memory.RP2350_XIPMemory @ { sysbus new Bus.BusPointRegistration { address: 0x1e000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0x1e000000; cpu: d_dma_bus } }
    flash: d_flash
    qmi: d_qmi
    xip: d_xip
    useCache: false
    untranslated: true
    windowOffset: 0x2000000



d_uart0:
    Qspi: d_qspi
