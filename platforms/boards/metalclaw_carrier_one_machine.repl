d_sio: Miscellaneous.RP2040_SIO @ { sysbus new Bus.BusPointRegistration { address: 0xd0000000; cluster: d_cluster }; sysbus new Bus.BusPointRegistration { address: 0xd0000000; cpu: d_dma_bus }; d_psm 14 }
