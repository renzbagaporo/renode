// Generated by scripts/multi-node/gen_rp2_chip_repl.py: the Metalclaw carrier's
// RP2354B harness (h_) and its Pico DUT (d_) as two chips in one machine.
//   gen_rp2_chip_repl.py h platforms/boards/metalclaw_pico_rp2.repl
//   gen_rp2_chip_repl.py d platforms/boards/raspberry_pi_pico.repl

h_chip: Miscellaneous.RP2_Chip @ sysbus
    prefix: "h_"
h_cluster: CPU.Cluster @ sysbus
h_dma_bus: Miscellaneous.RP2_BusMaster @ sysbus












h_cpu0: CPU.CortexM @ h_cluster
    cpuType: "cortex-m33-rp2350"
    nvic: h_nvic0
    enableTrustZone: true
    GPIOCoprocessor: h_sio
    InitVectorTableOffset: 0
    
    
    WfiFollowsClock: true

h_cpu1: CPU.CortexM @ h_cluster
    cpuType: "cortex-m33-rp2350"
    nvic: h_nvic1
    cpuId: 1
    enableTrustZone: true
    GPIOCoprocessor: h_sio
    InitVectorTableOffset: 0
    WfiFollowsClock: true
    isCpuWaitSignalSet: true

// The RISC-V cores join h_cluster before anything registers for the
// cluster, so each registration reaches them as well as the Arm cores.
h_riscv0: CPU.RP2350_Hazard3 @ h_cluster
    hartId: 0
    WfiFollowsClock: true

h_riscv1: CPU.RP2350_Hazard3 @ h_cluster
    hartId: 1
    WfiFollowsClock: true

h_nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: h_cpu0 };
    sysbus new Bus.BusMultiRegistration { address: 0xe002e000; size: 0x1000; region: "NonSecure"; cpu: h_cpu0 }
}
    -> h_cpu0@0
    systickFrequency: 6000000
    priorityMask: 0xf0

h_nvic1: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: h_cpu1 };
    sysbus new Bus.BusMultiRegistration { address: 0xe002e000; size: 0x1000; region: "NonSecure"; cpu: h_cpu1 }
}
    -> h_cpu1@0
    systickFrequency: 6000000
    priorityMask: 0xf0

h_rom: Memory.RP2350_ROM @ { sysbus new Bus.BusPointRegistration { address: 0; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0; cpu: h_dma_bus }; h_psm 8 }

h_bootram: Memory.RP2350_BootRAM @ { sysbus new Bus.BusPointRegistration { address: 0x400e0000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400e0000; cpu: h_dma_bus }; h_psm 9 }
    accessControl: h_accessctrl

h_sram: Memory.MappedMemory @ { sysbus new Bus.BusPointRegistration { address: 0x20000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x20000000; cpu: h_dma_bus } }
    size: 0x40000

h_sramHigh: Memory.MappedMemory @ { sysbus new Bus.BusPointRegistration { address: 0x20040000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x20040000; cpu: h_dma_bus } }
    size: 0x42000

h_resets: Miscellaneous.RP2_Resets @ { sysbus new Bus.BusPointRegistration { address: 0x40020000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40020000; cpu: h_dma_bus }; h_psm 4 }
    rp2350: true

h_xosc: Miscellaneous.RP2_XOSC @ { sysbus new Bus.BusPointRegistration { address: 0x40048000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40048000; cpu: h_dma_bus }; h_psm 3 }
    crystalFrequency: 12000000
    rp2350: true

h_rosc: Miscellaneous.RP2350_ROSC @ { sysbus new Bus.BusPointRegistration { address: 0x400e8000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400e8000; cpu: h_dma_bus }; h_psm 2 }

h_pll_sys: Miscellaneous.RP2_PLL @ {
    sysbus new Bus.BusPointRegistration { address: 0x40050000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40050000; cpu: h_dma_bus };
    h_resets 14
}
    xosc: h_xosc
    rp2350: true

h_pll_usb: Miscellaneous.RP2_PLL @ {
    sysbus new Bus.BusPointRegistration { address: 0x40058000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40058000; cpu: h_dma_bus };
    h_resets 15
}
    xosc: h_xosc
    rp2350: true

h_clocks: Miscellaneous.RP2350_Clocks @ { sysbus new Bus.BusPointRegistration { address: 0x40010000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40010000; cpu: h_dma_bus }; h_psm 5 }
    xosc: h_xosc
    rosc: h_rosc
    pllSys: h_pll_sys
    pllUsb: h_pll_usb
    nvic0: h_nvic0
    nvic1: h_nvic1
    IRQ -> h_nvic0@30 | h_riscv0@30 | h_nvic1@30 | h_riscv1@30


h_ticks: Miscellaneous.RP2350_Ticks @ { sysbus new Bus.BusPointRegistration { address: 0x40108000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40108000; cpu: h_dma_bus }; h_psm 5 }
    clocks: h_clocks
    timer0: h_timer0
    timer1: h_timer1

h_sha256: Miscellaneous.RP2350_SHA256 @ { sysbus new Bus.BusPointRegistration { address: 0x400f8000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400f8000; cpu: h_dma_bus }; h_resets 17 }
    clocks: h_clocks
    DREQ -> h_dma@54



h_hstx: Miscellaneous.RP2350_HSTX @ { sysbus new Bus.BusPointRegistration { address: 0x400c0000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400c0000; cpu: h_dma_bus }; h_resets 3 }
    clocks: h_clocks
    DREQ -> h_dma@52

h_hstx_fifo: Miscellaneous.RP2350_HSTXFifo @ { sysbus new Bus.BusPointRegistration { address: 0x50600000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50600000; cpu: h_dma_bus } }
    hstx: h_hstx

h_trng: Miscellaneous.RP2350_TRNG @ { sysbus new Bus.BusPointRegistration { address: 0x400f0000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400f0000; cpu: h_dma_bus }; h_resets 25 }
