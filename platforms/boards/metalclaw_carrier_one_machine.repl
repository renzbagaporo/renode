h_debug_port: CPU.RP2350_DebugPort @ sysbus
    architectureSelector: h_architecture
    cpu0: h_cpu0
    cpu1: h_cpu1

h_powman: Miscellaneous.RP2350_POWMAN @ { sysbus new Bus.BusPointRegistration { address: 0x40100000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40100000; cpu: h_dma_bus } }
    architectureSelector: h_architecture
    xosc: h_xosc
    rosc: h_rosc
    gpio: h_gpio
    TimerIRQ -> h_nvic0@45 | h_riscv0@45 | h_nvic1@45 | h_riscv1@45
    core0: h_cpu0
    core1: h_cpu1
    nvic0: h_nvic0
    nvic1: h_nvic1
    debugPort: h_debug_port
    bootRAM: h_bootram
    xip: h_xip
    sramLow: h_sram
    sramHigh: h_sramHigh

