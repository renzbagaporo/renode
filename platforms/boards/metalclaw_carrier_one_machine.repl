h_timer0: Timers.RP2_Timer @ { sysbus new Bus.BusPointRegistration { address: 0x400b0000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x400b0000; cpu: h_dma_bus }; h_resets 23 }
