h_otp: Miscellaneous.RP2350_OTP @ { sysbus new Bus.BusPointRegistration { address: 0x40120000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40120000; cpu: h_dma_bus }; h_psm 1 }

h_otpData: Memory.RP2350_OTPData @ { sysbus new Bus.BusPointRegistration { address: 0x40130000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40130000; cpu: h_dma_bus } }
