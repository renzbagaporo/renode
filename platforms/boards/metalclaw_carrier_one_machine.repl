h_sysinfo: Miscellaneous.RP2350_SYSINFO @ { sysbus new Bus.BusPointRegistration { address: 0x40000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40000000; cpu: h_dma_bus }; h_resets 21 }

h_accessctrl: Miscellaneous.RP2350_AccessControl @ { sysbus new Bus.BusPointRegistration { address: 0x40060000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40060000; cpu: h_dma_bus }; h_psm 22 }

h_psm: Miscellaneous.RP2350_PSM @ { sysbus new Bus.BusPointRegistration { address: 0x40018000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x40018000; cpu: h_dma_bus } }
    core0: h_cpu0
    core1: h_cpu1
    nvic0: h_nvic0
    nvic1: h_nvic1

h_dpram: USB.RP2_USB_DPRAM @ { sysbus new Bus.BusPointRegistration { address: 0x50100000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0x50100000; cpu: h_dma_bus } }

h_sio: Miscellaneous.RP2350_SIO @ {
    h_psm 21;
    sysbus new Bus.BusPointRegistration { address: 0xd0000000; cluster: h_cluster }; sysbus new Bus.BusPointRegistration { address: 0xd0000000; cpu: h_dma_bus };
    sysbus new Bus.BusMultiRegistration { address: 0xd0020000; size: 0x1000; region: "NonSecure"; cluster: h_cluster }; sysbus new Bus.BusMultiRegistration { address: 0xd0020000; size: 0x1000; region: "NonSecure"; cpu: h_dma_bus }
}
    accessControl: h_accessctrl
    Core0IRQ -> h_nvic0@25 | h_riscv0@25
    Core1IRQ -> h_nvic1@25 | h_riscv1@25
    Core0NonSecureIRQ -> h_nvic0@27 | h_riscv0@27
    Core1NonSecureIRQ -> h_nvic1@27 | h_riscv1@27
    Core0DoorbellIRQ -> h_nvic0@26 | h_riscv0@26
    Core1DoorbellIRQ -> h_nvic1@26 | h_riscv1@26
