// RP2354B: the RP2350B die in the QFN-80 package, with all 48 bank 0 GPIOs
// bonded, and 2 MiB of serial flash stacked in the package on QMI chip
// select 0. Board descriptions add any external memories.

using "platforms/cpus/rp2350.repl"

flashMemory: Memory.MappedMemory
    size: 0x200000

flash: SPI.WinbondW25QFlash
    underlyingMemory: flashMemory

qmi: MemoryControllers.RP2350_QMI @ { sysbus 0x400d0000; psm 20 }
    flash: flash
    clocks: clocks

xipMemory: Memory.RP2350_XIPMemory @ sysbus 0x10000000
    flash: flash
    qmi: qmi
    xip: xip

xipUncached: Memory.RP2350_XIPMemory @ sysbus 0x14000000
    flash: flash
    qmi: qmi
    xip: xip
    useCache: false

xipUntranslated: Memory.RP2350_XIPMemory @ sysbus 0x1c000000
    flash: flash
    qmi: qmi
    untranslated: true
    useCache: false
    xip: xip

qspi: GPIOPort.RP2350_QSPI @ { sysbus 0x40030000; resets 7 }
    qmi: qmi
    sio: sio
    accessControl: accessctrl
    Core0IRQ -> nvic0@23
    Core1IRQ -> nvic1@23
    Core0NonSecureIRQ -> nvic0@24
    Core1NonSecureIRQ -> nvic1@24

qpads: GPIOPort.RP2350_PadsQSPI @ { sysbus 0x40040000; resets 10 }
    gpio: qspi

sysinfo:
    packageQfn60: false

gpio:
    numberOfPins: 48

xipCacheMemory: Memory.RP2350_XIPMemory @ sysbus 0x12000000
    flash: flash
    qmi: qmi
    xip: xip
    windowOffset: 0x2000000

xipUncachedReserved: Memory.RP2350_XIPMemory @ sysbus 0x16000000
    flash: flash
    qmi: qmi
    xip: xip
    useCache: false
    windowOffset: 0x2000000

xipUntranslatedReserved: Memory.RP2350_XIPMemory @ sysbus 0x1e000000
    flash: flash
    qmi: qmi
    xip: xip
    useCache: false
    untranslated: true
    windowOffset: 0x2000000
