// RP2350 dual Cortex-M33 processor and on-chip memories.
// Board descriptions provide external serial flash.

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33-rp2350"
    nvic: nvic0
    enableTrustZone: true
    GPIOCoprocessor: sio
    InitVectorTableOffset: 0
    // A waiting core follows the shared clock, so an interrupt that another
    // device raises is taken within 2 us of its time.
    WfiFollowsClock: true

cpu1: CPU.CortexM @ sysbus
    cpuType: "cortex-m33-rp2350"
    nvic: nvic1
    cpuId: 1
    enableTrustZone: true
    GPIOCoprocessor: sio
    InitVectorTableOffset: 0
    WfiFollowsClock: true
    isCpuWaitSignalSet: true

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 };
    sysbus new Bus.BusMultiRegistration { address: 0xe002e000; size: 0x1000; region: "NonSecure"; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 6000000
    priorityMask: 0xf0

nvic1: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu1 };
    sysbus new Bus.BusMultiRegistration { address: 0xe002e000; size: 0x1000; region: "NonSecure"; cpu: cpu1 }
}
    -> cpu1@0
    systickFrequency: 6000000
    priorityMask: 0xf0

rom: Memory.RP2350_ROM @ { sysbus 0; psm 8 }

bootram: Memory.RP2350_BootRAM @ { sysbus 0x400e0000; psm 9 }
    accessControl: accessctrl

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

sramHigh: Memory.MappedMemory @ sysbus 0x20040000
    size: 0x42000

resets: Miscellaneous.RP2_Resets @ { sysbus 0x40020000; psm 4 }
    rp2350: true

xosc: Miscellaneous.RP2_XOSC @ { sysbus 0x40048000; psm 3 }
    crystalFrequency: 12000000
    rp2350: true

rosc: Miscellaneous.RP2350_ROSC @ { sysbus 0x400e8000; psm 2 }

pll_sys: Miscellaneous.RP2_PLL @ {
    sysbus 0x40050000;
    resets 14
}
    xosc: xosc
    rp2350: true

pll_usb: Miscellaneous.RP2_PLL @ {
    sysbus 0x40058000;
    resets 15
}
    xosc: xosc
    rp2350: true

clocks: Miscellaneous.RP2350_Clocks @ { sysbus 0x40010000; psm 5 }
    xosc: xosc
    rosc: rosc
    pllSys: pll_sys
    pllUsb: pll_usb
    nvic0: nvic0
    nvic1: nvic1
    IRQ -> nvic0@30 | riscv0@30 | nvic1@30 | riscv1@30

// Model CLOCKS as the reset stage for the system-level tick generator.
ticks: Miscellaneous.RP2350_Ticks @ { sysbus 0x40108000; psm 5 }
    clocks: clocks
    timer0: timer0
    timer1: timer1

sha256: Miscellaneous.RP2350_SHA256 @ { sysbus 0x400f8000; resets 17 }
    clocks: clocks

trng: Miscellaneous.RP2350_TRNG @ { sysbus 0x400f0000; resets 25 }
    clocks: clocks
    IRQ -> nvic0@39 | riscv0@39 | nvic1@39 | riscv1@39

debug_port: CPU.RP2350_DebugPort @ sysbus
    architectureSelector: architecture
    cpu0: cpu0
    cpu1: cpu1

powman: Miscellaneous.RP2350_POWMAN @ sysbus 0x40100000
    architectureSelector: architecture
    core0: cpu0
    core1: cpu1
    nvic0: nvic0
    nvic1: nvic1
    debugPort: debug_port
    bootRAM: bootram
    xip: xip
    sramLow: sram
    sramHigh: sramHigh

nvic0:
    SystemResetRequest -> powman@0

nvic1:
    SystemResetRequest -> powman@1

otp: Miscellaneous.RP2350_OTP @ { sysbus 0x40120000; psm 1 }

otpData: Memory.RP2350_OTPData @ sysbus 0x40130000
    otp: otp

otpRaw: Memory.RP2350_OTPData @ sysbus 0x40134000
    otp: otp
    raw: true

otpGuarded: Memory.RP2350_OTPData @ sysbus 0x40138000
    otp: otp
    guarded: true

otpRawGuarded: Memory.RP2350_OTPData @ sysbus 0x4013c000
    otp: otp
    raw: true
    guarded: true

sysinfo: Miscellaneous.RP2350_SYSINFO @ { sysbus 0x40000000; resets 21 }

accessctrl: Miscellaneous.RP2350_AccessControl @ { sysbus 0x40060000; psm 22 }

psm: Miscellaneous.RP2350_PSM @ sysbus 0x40018000
    core0: cpu0
    core1: cpu1
    nvic0: nvic0
    nvic1: nvic1

dpram: USB.RP2_USB_DPRAM @ sysbus 0x50100000

sio: Miscellaneous.RP2350_SIO @ {
    psm 21;
    sysbus 0xd0000000;
    sysbus new Bus.BusMultiRegistration { address: 0xd0020000; size: 0x1000; region: "NonSecure" }
}
    accessControl: accessctrl
    Core0IRQ -> nvic0@25 | riscv0@25
    Core1IRQ -> nvic1@25 | riscv1@25
    Core0NonSecureIRQ -> nvic0@27 | riscv0@27
    Core1NonSecureIRQ -> nvic1@27 | riscv1@27
    Core0DoorbellIRQ -> nvic0@26 | riscv0@26
    Core1DoorbellIRQ -> nvic1@26 | riscv1@26
    Core0NonSecureDoorbellIRQ -> nvic0@28 | riscv0@28
    Core1NonSecureDoorbellIRQ -> nvic1@28 | riscv1@28

timer0: Timers.RP2_Timer @ { sysbus 0x400b0000; resets 23 }
    clocked: true
    rp2350: true
    0 -> nvic0@0 | riscv0@0 | nvic1@0 | riscv1@0
    1 -> nvic0@1 | riscv0@1 | nvic1@1 | riscv1@1
    2 -> nvic0@2 | riscv0@2 | nvic1@2 | riscv1@2
    3 -> nvic0@3 | riscv0@3 | nvic1@3 | riscv1@3

timer1: Timers.RP2_Timer @ { sysbus 0x400b8000; resets 24 }
    clocked: true
    rp2350: true
    0 -> nvic0@4 | riscv0@4 | nvic1@4 | riscv1@4
    1 -> nvic0@5 | riscv0@5 | nvic1@5 | riscv1@5
    2 -> nvic0@6 | riscv0@6 | nvic1@6 | riscv1@6
    3 -> nvic0@7 | riscv0@7 | nvic1@7 | riscv1@7

watchdog: Miscellaneous.RP2350_Watchdog @ sysbus 0x400d8000
    ticks: ticks
    psm: psm
    powman: powman

gpio: GPIOPort.RP2_GPIOBank0 @ { sysbus 0x40028000; resets 6 }
    sio: sio
    rp2350: true
    accessControl: accessctrl
    Core0IRQ -> nvic0@21 | riscv0@21
    Core1IRQ -> nvic1@21 | riscv1@21
    Core0NonSecureIRQ -> nvic0@22 | riscv0@22
    Core1NonSecureIRQ -> nvic1@22 | riscv1@22

pads: GPIOPort.RP2_PadsBank0 @ { sysbus 0x40038000; resets 9 }
    gpio: gpio
    rp2350: true

fpb0: CPU.ARM_FlashPatchBreakpoint @ sysbus new Bus.BusPointRegistration { address: 0xe0002000; cpu: cpu0 }
    cpu: cpu0

fpb1: CPU.ARM_FlashPatchBreakpoint @ sysbus new Bus.BusPointRegistration { address: 0xe0002000; cpu: cpu1 }
    cpu: cpu1

romTable: CPU.CortexM_ROMTable @ sysbus 0xe00ff000
    fpb: fpb0

usb: USB.RP2_USB @ { sysbus 0x50110000; resets 28 }
    dpram: dpram
    clockSource: clocks
    IRQ -> nvic0@14 | riscv0@14 | nvic1@14 | riscv1@14

xip: MemoryControllers.RP2350_XIP @ { sysbus 0x400c8000; psm 20 }

xipMaintenance: MemoryControllers.RP2350_XIPMaintenance @ sysbus 0x18000000
    xip: xip

dma: DMA.RP2040_DMA @ { sysbus 0x50000000; resets 2 }
    clocks: clocks
    rp2350: true
    IRQ0 -> nvic0@10 | riscv0@10 | nvic1@10 | riscv1@10
    IRQ1 -> nvic0@11 | riscv0@11 | nvic1@11 | riscv1@11
    IRQ2 -> nvic0@12 | riscv0@12 | nvic1@12 | riscv1@12
    IRQ3 -> nvic0@13 | riscv0@13 | nvic1@13 | riscv1@13

pio0: Miscellaneous.RP2040_PIO @ { sysbus 0x50200000; resets 11 }
    gpio: gpio
    clocks: clocks
    pioId: 0
    rp2350: true
    0 -> dma@0
    1 -> dma@1
    2 -> dma@2
    3 -> dma@3
    4 -> dma@4
    5 -> dma@5
    6 -> dma@6
    7 -> dma@7
    8 -> nvic0@15 | riscv0@15 | nvic1@15 | riscv1@15
    9 -> nvic0@16 | riscv0@16 | nvic1@16 | riscv1@16

pio1: Miscellaneous.RP2040_PIO @ { sysbus 0x50300000; resets 12 }
    gpio: gpio
    clocks: clocks
    pioId: 1
    rp2350: true
    0 -> dma@8
    1 -> dma@9
    2 -> dma@10
    3 -> dma@11
    4 -> dma@12
    5 -> dma@13
    6 -> dma@14
    7 -> dma@15
    8 -> nvic0@17 | riscv0@17 | nvic1@17 | riscv1@17
    9 -> nvic0@18 | riscv0@18 | nvic1@18 | riscv1@18

pio2: Miscellaneous.RP2040_PIO @ { sysbus 0x50400000; resets 13 }
    gpio: gpio
    clocks: clocks
    pioId: 2
    rp2350: true
    0 -> dma@16
    1 -> dma@17
    2 -> dma@18
    3 -> dma@19
    4 -> dma@20
    5 -> dma@21
    6 -> dma@22
    7 -> dma@23
    8 -> nvic0@19 | riscv0@19 | nvic1@19 | riscv1@19
    9 -> nvic0@20 | riscv0@20 | nvic1@20 | riscv1@20

uart0: UART.RP2_UART @ { sysbus 0x40070000; resets 26 }
    clocks: clocks
    gpio: gpio
    index: 0
    rp2350: true
    IRQ -> nvic0@33 | riscv0@33 | nvic1@33 | riscv1@33
    TxDMA -> dma@28
    RxDMA -> dma@29

uart1: UART.RP2_UART @ { sysbus 0x40078000; resets 27 }
    clocks: clocks
    gpio: gpio
    index: 1
    rp2350: true
    IRQ -> nvic0@34 | riscv0@34 | nvic1@34 | riscv1@34
    TxDMA -> dma@30
    RxDMA -> dma@31

spi0: SPI.RP2_SPI @ { sysbus 0x40080000; resets 18 }
    clocks: clocks
    gpio: gpio
    index: 0
    IRQ -> nvic0@31 | riscv0@31 | nvic1@31 | riscv1@31
    TxDMA -> dma@24
    RxDMA -> dma@25

spi1: SPI.RP2_SPI @ { sysbus 0x40088000; resets 19 }
    clocks: clocks
    gpio: gpio
    index: 1
    IRQ -> nvic0@32 | riscv0@32 | nvic1@32 | riscv1@32
    TxDMA -> dma@26
    RxDMA -> dma@27

i2c0: I2C.RP2_I2C @ { sysbus 0x40090000; resets 4 }
    clocks: clocks
    gpio: gpio
    index: 0
    IRQ -> nvic0@36 | riscv0@36 | nvic1@36 | riscv1@36
    TxDMA -> dma@44
    RxDMA -> dma@45

i2c1: I2C.RP2_I2C @ { sysbus 0x40098000; resets 5 }
    clocks: clocks
    gpio: gpio
    index: 1
    IRQ -> nvic0@37 | riscv0@37 | nvic1@37 | riscv1@37
    TxDMA -> dma@46
    RxDMA -> dma@47

// Two alternative execution engines occupy the same physical PE sockets.
// Their hart IDs remain 0/1; SystemBus assigns distinct engine slots.
riscv0: CPU.RP2350_Hazard3 @ sysbus
    hartId: 0
    clocks: clocks
    WfiFollowsClock: true

riscv1: CPU.RP2350_Hazard3 @ sysbus
    hartId: 1
    clocks: clocks
    WfiFollowsClock: true

architecture: Miscellaneous.RP2350_ArchitectureSelector @ sysbus
    arm0: cpu0
    arm1: cpu1
    riscv0: riscv0
    riscv1: riscv1
    nvic0: nvic0
    nvic1: nvic1
    otp: otp
    psm: psm
