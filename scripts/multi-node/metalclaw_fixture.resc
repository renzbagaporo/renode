# Set these file variables before including this script:
#   $harness_rom: RP2040 B2 16 KiB mask ROM binary, extracted with
#     extract_rp2040_mask_rom.py in this directory from the B2 boot ROM ELF
#     https://raw.githubusercontent.com/matgla/Renode_RP2040/5aca847c9f57ed96603e55d28e8ceeefa09e55f6/bootroms/rp2040/b2.elf
#     ELF sha256 3a3c4c617d83bc9b910a6fa7bfdffa11ce26ff89370271d861507be821cc49aa
#     binary sha256 9c19b46f068c21f90d200c514faad4a0d5cecfc978f155b8c9d25cb6bc2efd81
#   $harness_flash: raw flash payload extracted from the Metalclaw Pico 1 UF2
#     with extract_pico1_uf2.py in this directory
#   $dut_rom: RP2350 A2 combined boot ROM binary
#     https://github.com/raspberrypi/pico-bootrom-rp2350/releases/download/A2/bootrom-combined.bin
#     sha256 196c503fbb17b2ad21a1f496574786af698f9376af9a5f79e5e75293c9e12191
# Pico 2 flash starts erased and is programmed through the SWD probe.

$usbip_port?=3240
$quantum?="0.0001"
# Wire latency between the boards in microseconds; it must exceed two
# quanta. The DUT's SPI input delay is the round trip in nanoseconds.
# Both are defined before any machine is selected, so every machine sees them.
$wire_latency_us?=300
$spi_input_delay_ns?=600000

mach create "pico1"
machine LoadPlatformDescription @platforms/boards/raspberry_pi_pico.repl
sysbus LoadBinary $harness_rom 0
xipMemory LoadBinary $harness_flash

mach create "pico2"
machine LoadPlatformDescription @platforms/boards/raspberry_pi_pico2.repl
rom LoadBinary $dut_rom

# SWCLK, SWDIO and active-low RUN use Pico 1 GPIOs 2, 3 and 28.
emulation CreateDigitalWire "swclk" false
emulation CreateDigitalWire "swdio" true
emulation CreateDigitalWire "run" true
swclk Connect debug_port 0
swdio Connect debug_port 1
run Connect debug_port 2
mach set "pico1"
swclk Connect gpio 2
swdio Connect gpio 3
run Connect gpio 28

# Serial and control lines connect equal GP numbers on both boards, except
# UART0, which is crossed. Each board sees the other's edges $wire_latency_us
# later on the sender's clock, preserving bit timing across the quantum.
emulation CreateDelayedDigitalWire "uart0_dut_tx" true $wire_latency_us
emulation CreateDelayedDigitalWire "uart0_harness_tx" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp8" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp9" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp6" true $wire_latency_us
mach set "pico2"
uart0_dut_tx Connect gpio 0
uart0_harness_tx Connect gpio 1
gp8 Connect gpio 8
gp9 Connect gpio 9
gp6 Connect gpio 6
mach set "pico1"
uart0_dut_tx Connect gpio 1
uart0_harness_tx Connect gpio 0
gp8 Connect gpio 8
gp9 Connect gpio 9
gp6 Connect gpio 6

# SPI0 and the radio lines: SCK 18, MOSI 19 and the DUT's GPIO chip selects
# 17, 21 and 22 run to the harness; MISO 16, BUSY 7 or 10 and DIO1 20 return.
# Fixture 1 connects GP6 to GP22 straight through, so both BUSY pins are wired.
# The DUT samples MISO one round trip, $spi_input_delay_ns, after each sampling edge.
emulation CreateDelayedDigitalWire "gp18" false $wire_latency_us
emulation CreateDelayedDigitalWire "gp19" false $wire_latency_us
emulation CreateDelayedDigitalWire "gp16" false $wire_latency_us
emulation CreateDelayedDigitalWire "gp17" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp21" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp22" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp7" false $wire_latency_us
emulation CreateDelayedDigitalWire "gp10" false $wire_latency_us
emulation CreateDelayedDigitalWire "gp20" false $wire_latency_us
mach set "pico2"
gp18 Connect gpio 18
gp19 Connect gpio 19
gp16 Connect gpio 16
gp17 Connect gpio 17
gp21 Connect gpio 21
gp22 Connect gpio 22
gp7 Connect gpio 7
gp10 Connect gpio 10
gp20 Connect gpio 20
spi0 InputDelayNanoseconds $spi_input_delay_ns
mach set "pico1"
gp18 Connect gpio 18
gp19 Connect gpio 19
gp16 Connect gpio 16
gp17 Connect gpio 17
gp21 Connect gpio 21
gp22 Connect gpio 22
gp7 Connect gpio 7
gp10 Connect gpio 10
gp20 Connect gpio 20

# I2C0 on SDA 4 and SCL 5: the DUT controller and the harness target share
# a byte-level bus. Each answer reaches the DUT one round trip after its
# request, and the DUT holds the clock until it does.
emulation CreateDelayedI2CBus "i2c_gp4_gp5" $wire_latency_us
mach set "pico2"
i2c_gp4_gp5 Connect i2c0 4 5
mach set "pico1"
i2c_gp4_gp5 Connect i2c0 4 5

emulation SetGlobalQuantum $quantum
emulation SetGlobalAdvanceImmediately true
emulation CreateUSBIPServer $usbip_port "pico1"
host.pico1 Register usb 0 Full
