# One-machine version of metalclaw_fixture.resc, generated by one_machine_bench.py:
# machine "bench" holds the harness chip (h_*) and the DUT chip (d_*) of
# metalclaw_fixture_one_machine.repl, joined by zero-latency wires.
# Set these file variables before including this script:
#   $harness_rom: RP2040 B2 16 KiB mask ROM binary, extracted with
#     extract_rp2040_mask_rom.py in this directory from the B2 boot ROM ELF
#     https://raw.githubusercontent.com/matgla/Renode_RP2040/5aca847c9f57ed96603e55d28e8ceeefa09e55f6/bootroms/rp2040/b2.elf
#     ELF sha256 3a3c4c617d83bc9b910a6fa7bfdffa11ce26ff89370271d861507be821cc49aa
#     binary sha256 9c19b46f068c21f90d200c514faad4a0d5cecfc978f155b8c9d25cb6bc2efd81
#   $harness_flash: raw flash payload extracted from the Metalclaw Pico 1 UF2
#     with extract_pico1_uf2.py in this directory
#   $dut_rom: RP2350 A2 combined boot ROM binary
#     https://github.com/raspberrypi/pico-bootrom-rp2350/releases/download/A2/bootrom-combined.bin
#     sha256 196c503fbb17b2ad21a1f496574786af698f9376af9a5f79e5e75293c9e12191
# Pico 2 flash starts erased and is programmed through the SWD probe.

$usbip_port?=3240
# The DUT's own USB/IP server.
$dut_usbip_port?=3250
$quantum?="0.00001"
$dual_platform?=@platforms/boards/metalclaw_fixture_one_machine.repl

mach create "bench"
machine LoadPlatformDescription $dual_platform
sysbus LoadBinary $harness_rom 0 sysbus.h_cluster.h_cpu0
h_xipMemory LoadBinary $harness_flash

d_rom LoadBinary $dut_rom

# SWCLK, SWDIO and active-low RUN use Pico 1 GPIOs 2, 3 and 28.
emulation CreateDigitalWire "swclk" false
emulation CreateDigitalWire "swdio" true
emulation CreateDigitalWire "run" true
swclk Connect d_debug_port 0
swdio Connect d_debug_port 1
run Connect d_debug_port 2
swclk Connect h_gpio 2
swdio Connect h_gpio 3
run Connect h_gpio 28

emulation CreateDigitalWire "uart0_dut_tx" false
emulation CreateDigitalWire "uart0_harness_tx" false
emulation CreateDigitalWire "gp8" false
emulation CreateDigitalWire "gp9" false
emulation CreateDigitalWire "gp6" false
uart0_dut_tx Connect d_gpio 0
uart0_harness_tx Connect d_gpio 1
gp8 Connect d_gpio 8
gp9 Connect d_gpio 9
gp6 Connect d_gpio 6
uart0_dut_tx Connect h_gpio 1
uart0_harness_tx Connect h_gpio 0
gp8 Connect h_gpio 8
gp9 Connect h_gpio 9
gp6 Connect h_gpio 6

# GP11-GP15, GP26 and GP27 run 1:1 between the boards.
emulation CreateDigitalWire "gp11" false
emulation CreateDigitalWire "gp12" false
emulation CreateDigitalWire "gp13" false
emulation CreateDigitalWire "gp14" false
emulation CreateDigitalWire "gp15" false
emulation CreateDigitalWire "gp26" false
emulation CreateDigitalWire "gp27" false
gp11 Connect d_gpio 11
gp12 Connect d_gpio 12
gp13 Connect d_gpio 13
gp14 Connect d_gpio 14
gp15 Connect d_gpio 15
gp26 Connect d_gpio 26
gp27 Connect d_gpio 27
gp11 Connect h_gpio 11
gp12 Connect h_gpio 12
gp13 Connect h_gpio 13
gp14 Connect h_gpio 14
gp15 Connect h_gpio 15
gp26 Connect h_gpio 26
gp27 Connect h_gpio 27

emulation CreateDigitalWire "gp18" false
emulation CreateDigitalWire "gp19" false
emulation CreateDigitalWire "gp16" false
emulation CreateDigitalWire "gp17" false
emulation CreateDigitalWire "gp21" false
emulation CreateDigitalWire "gp22" false
emulation CreateDigitalWire "gp7" false
emulation CreateDigitalWire "gp10" false
emulation CreateDigitalWire "gp20" false
gp18 Connect d_gpio 18
gp19 Connect d_gpio 19
gp16 Connect d_gpio 16
gp17 Connect d_gpio 17
gp21 Connect d_gpio 21
gp22 Connect d_gpio 22
gp7 Connect d_gpio 7
gp10 Connect d_gpio 10
gp20 Connect d_gpio 20
gp18 Connect h_gpio 18
gp19 Connect h_gpio 19
gp16 Connect h_gpio 16
gp17 Connect h_gpio 17
gp21 Connect h_gpio 21
gp22 Connect h_gpio 22
gp7 Connect h_gpio 7
gp10 Connect h_gpio 10
gp20 Connect h_gpio 20

emulation CreateDigitalWire "gp4" false
emulation CreateDigitalWire "gp5" false
gp4 Connect d_gpio 4
gp5 Connect d_gpio 5
gp4 Connect h_gpio 4
gp5 Connect h_gpio 5

emulation SetGlobalQuantum $quantum
emulation SetGlobalAdvanceImmediately true
emulation CreateUSBIPServer $usbip_port "pico1"
host.pico1 Register h_usb 0 Full
# The DUT's own USB device, whose connector reaches the rig host on the
# bench, is bus ID 1-1 on a USB/IP server of its own on $dut_usbip_port: a
# USB/IP server serves one client at a time, and the rig holds the
# harness's import for the whole session.
emulation CreateUSBIPServer $dut_usbip_port "dut"
host.dut Register d_usb 1 Full
