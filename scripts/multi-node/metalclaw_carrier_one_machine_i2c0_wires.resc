# Included by metalclaw_carrier_one_machine.resc when $i2c0_wiring names this file.
# DUT GP4/GP5 as plain pin-level wires, with the 5.1 kOhm pull-ups of the
# other GP nets. Like the other two-branch Pico pins, each reaches two
# harness GPIOs on one net: GP4 GPIO11 and GPIO12, GP5 GPIO10 and GPIO13.
emulation CreateDigitalWire "gp4" true
emulation CreateDigitalWire "gp5" true
gp4 Connect d_gpio 4
gp5 Connect d_gpio 5
gp4 Connect h_gpio 11
gp4 Connect h_gpio 12
gp5 Connect h_gpio 10
gp5 Connect h_gpio 13
