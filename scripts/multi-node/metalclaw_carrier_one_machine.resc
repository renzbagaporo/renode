# One-machine version of metalclaw_carrier.resc, generated by one_machine_bench.py:
# machine "bench" holds the harness chip (h_*) and the DUT chip (d_*) of
# metalclaw_carrier_one_machine.repl, joined by zero-latency wires.
# Metalclaw Pico RP2 carrier bench: an RP2354B harness ("carrier") and a
# Raspberry Pi Pico DUT ("pico"), wired as the carrier's v1.r1 netlist.
# Set these file variables before including this script:
#   $harness_rom: RP2350 A2 combined boot ROM binary
#     https://github.com/raspberrypi/pico-bootrom-rp2350/releases/download/A2/bootrom-combined.bin
#     sha256 196c503fbb17b2ad21a1f496574786af698f9376af9a5f79e5e75293c9e12191
#   $harness_flash: the raw 2 MiB in-package flash image of the carrier harness
#   $dut_rom: RP2040 B2 16 KiB mask ROM binary, extracted with
#     extract_rp2040_mask_rom.py in this directory (see metalclaw_carrier_one_machine.resc)
# The DUT's flash starts erased; load an image with `d_xipMemory LoadBinary`.

$usbip_port?=3240
# The DUT's own USB/IP server.
$dut_usbip_port?=3250
$quantum?="0.00001"
# The I2C0 bus latency; it must exceed two quanta.
$i2c_latency_us?=30
$dual_platform?=@platforms/boards/metalclaw_carrier_one_machine.repl
$i2c0_wiring?=@scripts/multi-node/metalclaw_carrier_one_machine_i2c0_bus.resc
# The harness's OTP chip ID; its USB serial is this value in hex.
$harness_chip_id?=0x00000000C0FFEE01

mach create "bench"
machine LoadPlatformDescription $dual_platform
h_rom LoadBinary $harness_rom
h_xipMemory LoadBinary $harness_flash
h_otp SetChipId $harness_chip_id

sysbus LoadBinary $dut_rom 0 sysbus.d_cluster.d_cpu0

# SWD multidrop to the Pico's RP2040 and its active-low RUN, from carrier
# GPIO17 (SWCLK), GPIO25 (SWDIO) and GPIO9 (RUN).
emulation CreateDigitalWire "swclk" false
emulation CreateDigitalWire "swdio" true
emulation CreateDigitalWire "run" true
swclk Connect d_debug_port 0
swdio Connect d_debug_port 1
run Connect d_debug_port 2
swclk Connect h_gpio 17
swdio Connect h_gpio 25
run Connect h_gpio 9

# Every Pico GP0-22 net has a 5.1 kOhm pull-up to the Pico's 3V3_OUT, so an
# undriven net reads high and any driver wins. Each net reaches one or two
# carrier GPIOs. GP4 and GP5 are connected below as $i2c0_wiring selects.
emulation CreateDigitalWire "gp0" true
emulation CreateDigitalWire "gp1" true
emulation CreateDigitalWire "gp2" true
emulation CreateDigitalWire "gp3" true
emulation CreateDigitalWire "gp6" true
emulation CreateDigitalWire "gp7" true
emulation CreateDigitalWire "gp8" true
emulation CreateDigitalWire "gp9" true
emulation CreateDigitalWire "gp10" true
emulation CreateDigitalWire "gp11" true
emulation CreateDigitalWire "gp12" true
emulation CreateDigitalWire "gp13" true
emulation CreateDigitalWire "gp14" true
emulation CreateDigitalWire "gp15" true
emulation CreateDigitalWire "gp16" true
emulation CreateDigitalWire "gp17" true
emulation CreateDigitalWire "gp18" true
emulation CreateDigitalWire "gp19" true
emulation CreateDigitalWire "gp20" true
emulation CreateDigitalWire "gp21" true
emulation CreateDigitalWire "gp22" true

gp0 Connect d_gpio 0
gp1 Connect d_gpio 1
gp2 Connect d_gpio 2
gp3 Connect d_gpio 3
gp6 Connect d_gpio 6
gp7 Connect d_gpio 7
gp8 Connect d_gpio 8
gp9 Connect d_gpio 9
gp10 Connect d_gpio 10
gp11 Connect d_gpio 11
gp12 Connect d_gpio 12
gp13 Connect d_gpio 13
gp14 Connect d_gpio 14
gp15 Connect d_gpio 15
gp16 Connect d_gpio 16
gp17 Connect d_gpio 17
gp18 Connect d_gpio 18
gp19 Connect d_gpio 19
gp20 Connect d_gpio 20
gp21 Connect d_gpio 21
gp22 Connect d_gpio 22

gp0 Connect h_gpio 3
gp0 Connect h_gpio 4
gp1 Connect h_gpio 2
gp1 Connect h_gpio 5
gp2 Connect h_gpio 6
gp3 Connect h_gpio 0
gp3 Connect h_gpio 7
gp6 Connect h_gpio 14
gp7 Connect h_gpio 8
gp7 Connect h_gpio 15
gp8 Connect h_gpio 19
gp8 Connect h_gpio 20
gp9 Connect h_gpio 18
gp9 Connect h_gpio 21
gp10 Connect h_gpio 22
gp11 Connect h_gpio 16
gp11 Connect h_gpio 23
gp12 Connect h_gpio 27
gp12 Connect h_gpio 28
gp13 Connect h_gpio 26
gp13 Connect h_gpio 29
gp14 Connect h_gpio 30
gp15 Connect h_gpio 24
gp15 Connect h_gpio 31
gp16 Connect h_gpio 35
gp16 Connect h_gpio 36
gp17 Connect h_gpio 34
gp17 Connect h_gpio 37
gp18 Connect h_gpio 38
gp19 Connect h_gpio 32
gp19 Connect h_gpio 39
gp20 Connect h_gpio 40
gp20 Connect h_gpio 45
gp21 Connect h_gpio 41
gp21 Connect h_gpio 46
gp22 Connect h_gpio 33

include $i2c0_wiring

# Harness GPIO42-44 reach Pico GP26-28 (ADC0-2) through identical two-stage
# RC filters: 330 Ohm, 10 nF to GND, 2.2 kOhm, 1.5 nF to GND at the Pico pin
# (R30/C7/R26/C6, R31/C8/R24/C5, R32/C9/R23/C4), with no pull-ups. The
# harness makes analog levels with PWM; each ADC conversion reads the filter
# output, ripple included. The wires end at the filters, not the Pico pads.
machine LoadPlatformDescriptionFromString "d_adc_filter0: Analog.RCLowPassFilter @ d_adc 0 { r1Ohms: 330; c1Nanofarads: 10; r2Ohms: 2200; c2Nanofarads: 1.5 }"
machine LoadPlatformDescriptionFromString "d_adc_filter1: Analog.RCLowPassFilter @ d_adc 1 { r1Ohms: 330; c1Nanofarads: 10; r2Ohms: 2200; c2Nanofarads: 1.5 }"
machine LoadPlatformDescriptionFromString "d_adc_filter2: Analog.RCLowPassFilter @ d_adc 2 { r1Ohms: 330; c1Nanofarads: 10; r2Ohms: 2200; c2Nanofarads: 1.5 }"
emulation CreateDigitalWire "gp26" false
emulation CreateDigitalWire "gp27" false
emulation CreateDigitalWire "gp28" false
gp26 Connect sysbus.d_adc.d_adc_filter0 0
gp27 Connect sysbus.d_adc.d_adc_filter1 0
gp28 Connect sysbus.d_adc.d_adc_filter2 0
gp26 Connect h_gpio 42
gp27 Connect h_gpio 43
gp28 Connect h_gpio 44

emulation SetGlobalQuantum $quantum
emulation SetGlobalAdvanceImmediately true
emulation CreateUSBIPServer $usbip_port "carrier"
host.carrier Register h_usb 0 Full
# The DUT's own USB device, whose connector reaches the rig host on the
# bench, is bus ID 1-1 on a USB/IP server of its own on $dut_usbip_port: a
# USB/IP server serves one client at a time, and the rig holds the
# harness's import for the whole session.
emulation CreateUSBIPServer $dut_usbip_port "dut"
host.dut Register d_usb 1 Full
