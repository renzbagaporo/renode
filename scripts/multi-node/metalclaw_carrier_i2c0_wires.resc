# Included by metalclaw_carrier.resc when $i2c0_wiring names this file.
# DUT GP4/GP5 as plain pin-level wires, with the 5.1 kOhm pull-ups of the
# other GP nets. Like the other two-branch Pico pins, each reaches two
# harness GPIOs on one net: GP4 GPIO11 and GPIO12, GP5 GPIO10 and GPIO13.
emulation CreateDelayedDigitalWire "gp4" true $wire_latency_us
emulation CreateDelayedDigitalWire "gp5" true $wire_latency_us
mach set "pico"
gp4 Connect gpio 4
gp5 Connect gpio 5
mach set "carrier"
gp4 Connect gpio 11
gp4 Connect gpio 12
gp5 Connect gpio 10
gp5 Connect gpio 13
